    CAST(NULL AS INT64) AS ttft_ms,
    CAST(NULL AS STRING) AS model_version,
    CAST(NULL AS STRING) AS tool_completed_name,
    CAST(NULL AS STRING) AS tool_completed_origin,
    CAST(NULL AS INT64) AS tool_completed_total_ms,
    CAST(NULL AS STRING) AS tool_error_name,
    CAST(NULL AS STRING) AS tool_error_origin,
    CAST(NULL AS INT64) AS tool_error_total_ms
  FROM `{{PROJECT}}.{{DATASET}}.{{VIEW_PREFIX}}_agent_completed`
  UNION ALL
  SELECT
