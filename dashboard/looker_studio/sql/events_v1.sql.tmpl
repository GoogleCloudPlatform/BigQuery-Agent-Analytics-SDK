-- events_v1.sql.tmpl — logical all-events union over the BQAA-generated
-- views (static v1 intersection = the ADK 1.27.0 inventory, 15 views).
--
-- The three logical placeholders (PROJECT, DATASET, VIEW_PREFIX) are
-- rendered to the executable sentinel bindings (template_bindings.yaml) by
-- tools/render_template.py, producing sql/events_v1.template.sql — the exact
-- SQL embedded in the canonical Looker Studio report. At hydration, the
-- Linking API sqlReplace substitutes the sentinel strings with user values.
--
-- Never references the raw agent_events table. Date-range parameters must be
-- enabled on the Looker Studio data source. Timezone frozen to UTC (v1);
-- @DS_START_DATE/@DS_END_DATE arrive as YYYYMMDD strings, end inclusive.
WITH events AS (
  SELECT
    timestamp,
    event_type,
    agent,
    session_id,
    invocation_id,
    user_id,
    trace_id,
    span_id,
    parent_span_id,
    status,
    error_message,
    is_truncated,
    CAST(NULL AS INT64) AS usage_prompt_tokens,
    CAST(NULL AS INT64) AS usage_completion_tokens,
    CAST(NULL AS INT64) AS usage_total_tokens,
    CAST(NULL AS INT64) AS llm_total_ms,
    CAST(NULL AS INT64) AS ttft_ms,
    CAST(NULL AS STRING) AS model_version,
    CAST(NULL AS STRING) AS tool_completed_name,
    CAST(NULL AS STRING) AS tool_completed_origin,
    CAST(NULL AS INT64) AS tool_completed_total_ms,
    CAST(NULL AS STRING) AS tool_error_name,
    CAST(NULL AS STRING) AS tool_error_origin,
    CAST(NULL AS INT64) AS tool_error_total_ms
  FROM `{{PROJECT}}.{{DATASET}}.{{VIEW_PREFIX}}_user_message_received`
  UNION ALL
  SELECT
    timestamp,
    event_type,
    agent,
    session_id,
    invocation_id,
    user_id,
    trace_id,
    span_id,
    parent_span_id,
    status,
    error_message,
    is_truncated,
    CAST(NULL AS INT64) AS usage_prompt_tokens,
    CAST(NULL AS INT64) AS usage_completion_tokens,
    CAST(NULL AS INT64) AS usage_total_tokens,
    CAST(NULL AS INT64) AS llm_total_ms,
    CAST(NULL AS INT64) AS ttft_ms,
    CAST(NULL AS STRING) AS model_version,
    CAST(NULL AS STRING) AS tool_completed_name,
    CAST(NULL AS STRING) AS tool_completed_origin,
    CAST(NULL AS INT64) AS tool_completed_total_ms,
    CAST(NULL AS STRING) AS tool_error_name,
    CAST(NULL AS STRING) AS tool_error_origin,
    CAST(NULL AS INT64) AS tool_error_total_ms
  FROM `{{PROJECT}}.{{DATASET}}.{{VIEW_PREFIX}}_llm_request`
  UNION ALL
  SELECT
    timestamp,
    event_type,
    agent,
    session_id,
    invocation_id,
    user_id,
    trace_id,
    span_id,
    parent_span_id,
    status,
    error_message,
    is_truncated,
    COALESCE(SAFE_CAST(JSON_VALUE(usage_metadata, '$.prompt_token_count') AS INT64), SAFE_CAST(JSON_VALUE(usage_metadata, '$.prompt_tokens') AS INT64), usage_prompt_tokens) AS usage_prompt_tokens,
    COALESCE(SAFE_CAST(JSON_VALUE(usage_metadata, '$.candidates_token_count') AS INT64), SAFE_CAST(JSON_VALUE(usage_metadata, '$.completion_tokens') AS INT64), usage_completion_tokens) AS usage_completion_tokens,
    COALESCE(SAFE_CAST(JSON_VALUE(usage_metadata, '$.total_token_count') AS INT64), SAFE_CAST(JSON_VALUE(usage_metadata, '$.total_tokens') AS INT64), usage_total_tokens) AS usage_total_tokens,
    total_ms AS llm_total_ms,
    ttft_ms AS ttft_ms,
    model_version AS model_version,
    CAST(NULL AS STRING) AS tool_completed_name,
    CAST(NULL AS STRING) AS tool_completed_origin,
    CAST(NULL AS INT64) AS tool_completed_total_ms,
    CAST(NULL AS STRING) AS tool_error_name,
    CAST(NULL AS STRING) AS tool_error_origin,
    CAST(NULL AS INT64) AS tool_error_total_ms
