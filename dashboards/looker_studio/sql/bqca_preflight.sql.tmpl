-- bqca_preflight.sql.tmpl — advisory BQCA data profile (last 30 days).
--
-- Run it only after sql/preflight.sql.tmpl returns zero rows. That structural
-- check is shared because BQCA writes the BQAA base-table schema; this query
-- reads the table itself, so a missing table or column is a query error here
-- rather than a reported problem. tools/hydrate_dashboard.py --profile bqca
-- runs both, caps this scan with --maximum_bytes_billed, and treats the
-- profile as advisory: it warns, it never blocks the link.
--
-- Returns one row per BQCA event type, zero-count types included, so an empty
-- table, a table without data-agent attribution, or a table that is not
-- written by BQCA is visible at a glance.
WITH allowlist AS (
  SELECT event_type, ordinal
  FROM UNNEST([
    'INVOCATION_STARTING',
    'USER_MESSAGE_RECEIVED',
    'AGENT_RESPONSE',
    'INVOCATION_COMPLETED',
    'LLM_RESPONSE',
    'EMBEDDING_SUGGESTION',
    'INVOCATION_ERROR',
    'AGENT_ERROR',
    'LLM_ERROR'
  ]) AS event_type WITH OFFSET AS ordinal
),
recent AS (
  SELECT
    event_type,
    NULLIF(
      JSON_VALUE(attributes, '$.session_metadata.state."data-agent-id"'),
      ''
    ) AS data_agent_id,
    IFNULL(JSON_VALUE(attributes, '$.fast_path') = 'true', FALSE) AS fast_path
  FROM `{{PROJECT}}.{{DATASET}}.{{TABLE}}`
  WHERE timestamp >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 30 DAY)
    AND event_type IN (
      'INVOCATION_STARTING',
      'USER_MESSAGE_RECEIVED',
      'AGENT_RESPONSE',
      'INVOCATION_COMPLETED',
      'LLM_RESPONSE',
      'EMBEDDING_SUGGESTION',
      'INVOCATION_ERROR',
      'AGENT_ERROR',
      'LLM_ERROR'
    )
)
SELECT
  a.event_type,
  COUNT(r.event_type) AS events_30d,
  COUNT(r.data_agent_id) AS events_with_data_agent_id,
  SAFE_DIVIDE(COUNT(r.data_agent_id), COUNT(r.event_type))
    AS data_agent_id_coverage,
  COUNTIF(r.fast_path) AS fast_path_events
FROM allowlist AS a
LEFT JOIN recent AS r
  ON r.event_type = a.event_type
GROUP BY a.event_type, a.ordinal
ORDER BY a.ordinal
