	partition events_v1 = m
		mode: import
		source =
				let
					Config = BQAA_Config,
					Raw = Value.NativeQuery(Config[Nav], Config[EventsSql]),
					Utc = Table.TransformColumns(Raw, {{"timestamp", each if _ is datetimezone then DateTimeZone.RemoveZone(DateTimeZone.ToUtc(_)) else _, type datetime}}),
					Typed = Table.TransformColumnTypes(Utc, {
						{"timestamp", type datetime},
						{"event_type", type text},
						{"agent", type text},
						{"session_id", type text},
						{"invocation_id", type text},
						{"user_id", type text},
						{"trace_id", type text},
						{"span_id", type text},
						{"parent_span_id", type text},
						{"status", type text},
						{"error_message", type text},
						{"is_truncated", type logical},
						{"usage_prompt_tokens", Int64.Type},
						{"usage_completion_tokens", Int64.Type},
						{"usage_total_tokens", Int64.Type},
						{"llm_total_ms", Int64.Type},
						{"ttft_ms", Int64.Type},
						{"model_version", type text},
						{"tool_completed_name", type text},
						{"tool_completed_origin", type text},
						{"tool_completed_total_ms", Int64.Type},
						{"tool_error_name", type text},
						{"tool_error_origin", type text},
						{"tool_error_total_ms", Int64.Type},
						{"event_date", type date},
						{"event_pk", type text},
						{"llm_response_pk", type text},
						{"tool_completed_pk", type text},
						{"tool_error_pk", type text}
					})
				in
					Typed
