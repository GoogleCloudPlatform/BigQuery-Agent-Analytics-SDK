	/// measure Tool Completion Events — oracle/queries/usage-tool-calls-over-time.sql (total_events)
	measure 'Tool Completion Events' = CALCULATE(COUNTROWS('events_v1'), KEEPFILTERS('events_v1'[event_type] = "TOOL_COMPLETED"))
		formatString: #,0
		displayFolder: Base
		lineageTag: 3d3b940d-f7f1-545a-9ff0-b96f8de8e9d4
		annotation bqaa_oracle_sha256 = 59bff49985acea78

	/// measure Distinct Tool Invocations — oracle/queries/usage-tool-invocations.sql (total_invocations)
	measure 'Distinct Tool Invocations' = CALCULATE(DISTINCTCOUNTNOBLANK('events_v1'[invocation_id]), KEEPFILTERS('events_v1'[event_type] = "TOOL_COMPLETED"), KEEPFILTERS(NOT ISBLANK('events_v1'[tool_completed_name])))
