/// Reporting projection over the BigQuery Agent Analytics event table.
table events_v1
	lineageTag: d3679098-e761-5faa-ab3d-77e0a59729b2

	/// measure Total Tokens — oracle/queries/usage-total-tokens-consumption-over-the-time.sql and oracle/queries/usage-token-usage-split-by-agent.sql and oracle/queries/usage-top-5-users-with-most-tokens-consumption.sql (total_tokens_consumed)
	measure 'Total Tokens' = SUM('events_v1'[usage_total_tokens])
		formatString: #,0
		displayFolder: Base
		lineageTag: 2fb30212-e449-51fa-bd72-b96bf7f02abb
		annotation bqaa_oracle_sha256 = a370958c9a1a9416

	/// measure Total Traces — oracle/queries/usage-total-traces-generation-over-the-time.sql (total_traces)
	measure 'Total Traces' = DISTINCTCOUNTNOBLANK('events_v1'[trace_id])
		formatString: #,0
		displayFolder: Base
		lineageTag: 6d1b5891-1116-5418-87b5-7d08424dce6a
		annotation bqaa_oracle_sha256 = e0abd2d69e821d8a

	/// measure Total Sessions — oracle/queries/usage-number-of-sessions-trend.sql (total_sessions)
	measure 'Total Sessions' = DISTINCTCOUNTNOBLANK('events_v1'[session_id])
