		annotation bqaa_oracle_sha256 = d60db8a2c336df45

	/// measure Total Users — oracle/queries/usage-user-growth-over-time.sql (total_users)
	measure 'Total Users' = DISTINCTCOUNTNOBLANK('events_v1'[user_id])
