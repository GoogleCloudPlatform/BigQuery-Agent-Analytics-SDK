	/// measure KPI Total Tokens Prior — oracle/queries/usage-total-tokens.sql (pop_total_tokens_prior)
	measure 'KPI Total Tokens Prior' = VAR _start = MIN('Date'[Date]) VAR _end = MAX('Date'[Date]) VAR _days = INT(_end - _start) + 1 RETURN CALCULATE([Total Tokens], REMOVEFILTERS('Date'), 'Date'[Date] >= _start - _days && 'Date'[Date] <= _start - 1)
		formatString: #,0
		displayFolder: Scorecards
		lineageTag: a04a830e-0367-58f1-b620-f7067d9548b5
		annotation bqaa_oracle_sha256 = bbc5606367cc18b0

	/// measure KPI Total Tokens Change % — oracle/queries/usage-total-tokens.sql (pop_total_tokens_change)
	measure 'KPI Total Tokens Change %' = VAR _cur = [Total Tokens] VAR _prev = [KPI Total Tokens Prior] RETURN IF(ISBLANK(_cur) || ISBLANK(_prev), BLANK(), DIVIDE(_cur - _prev, _prev))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Scorecards
		lineageTag: 1c0d69a9-791a-58a5-82d8-e7576bd0a48c
		annotation bqaa_oracle_sha256 = bbc5606367cc18b0

