		annotation bqaa_oracle_sha256 = 7cc0d0acc9f365e2

	/// measure Top 5 Agents by Tool Errors — oracle/queries/performance-top-5-agents-by-errors.sql (total_tool_errors)
	measure 'Top 5 Agents by Tool Errors' = VAR _top = TOPN(5, FILTER(ALLSELECTED('events_v1'[agent]), NOT ISBLANK([Tool Errors])), [Tool Errors], DESC, 'events_v1'[agent], ASC) RETURN CALCULATE([Tool Errors], KEEPFILTERS(_top))
		formatString: #,0
		displayFolder: Charts
		lineageTag: f1cb07d1-9a17-5283-ae56-0cf5dba9304f
		annotation bqaa_oracle_sha256 = 2edc0ef51eac1b26

	/// measure Top 5 Tools by Errors — oracle/queries/performance-top-5-tools-by-errors.sql (total_tool_errors)
	measure 'Top 5 Tools by Errors' = VAR _top = TOPN(5, FILTER(ALLSELECTED('events_v1'[tool_error_name]), NOT ISBLANK([Tool Errors])), [Tool Errors], DESC, 'events_v1'[tool_error_name], ASC) RETURN CALCULATE([Tool Errors], KEEPFILTERS(_top))
		formatString: #,0
		displayFolder: Charts
		lineageTag: 7e0ba7f5-a57a-5b73-bbea-810fe1b8312f
		annotation bqaa_oracle_sha256 = e77a73a2b228995a

	/// measure Top 5 Agents by LLM Calls — oracle/queries/usage-top-5-agents-by-llm-calls.sql (total_llm_calls)
	measure 'Top 5 Agents by LLM Calls' = VAR _top = TOPN(5, FILTER(ALLSELECTED('events_v1'[agent]), NOT ISBLANK([LLM Calls])), [LLM Calls], DESC, 'events_v1'[agent], ASC) RETURN CALCULATE([LLM Calls], KEEPFILTERS(_top))
		formatString: #,0
		displayFolder: Charts
		lineageTag: 7dc47be4-764c-5fb3-aa7d-765a07927875
		annotation bqaa_oracle_sha256 = 32abb5b42f9a1085

