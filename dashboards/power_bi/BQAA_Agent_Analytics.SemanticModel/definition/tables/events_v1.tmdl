		annotation bqaa_oracle_sha256 = 23d3cd094e247e47

	/// measure Total Events — oracle/queries/usage-top-5-users-by-events.sql (total_events)
	measure 'Total Events' = COUNTROWS('events_v1')
		formatString: #,0
		displayFolder: Base
		lineageTag: a55534e5-2d76-5625-a4ef-1a2737cace81
		annotation bqaa_oracle_sha256 = 7cc0d0acc9f365e2

	/// measure LLM Calls — oracle/queries/usage-llm-call-trends.sql and oracle/queries/usage-top-5-agents-by-llm-calls.sql (total_llm_calls)
	measure 'LLM Calls' = DISTINCTCOUNTNOBLANK('events_v1'[llm_response_pk])
