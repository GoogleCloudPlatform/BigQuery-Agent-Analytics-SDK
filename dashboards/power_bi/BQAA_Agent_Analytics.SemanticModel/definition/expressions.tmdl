	lineageTag: 6eff27c5-6b45-5573-bfca-aebdcb73257d

/// GCP project billed for BigQuery metadata and scan jobs.
expression BQAA_BillingProjectId = "test-project-0728-467323" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 528ba07d-2b6d-5dfd-b2b4-86fe502141cd

/// Anchor end date (YYYY-MM-DD) or auto for the newest non-empty partition.
expression BQAA_WindowEndDate = "auto" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 71af1832-fc18-5421-b3d9-970e4fabda52

/// Current reporting window length L in days (1..366); loads 2L days for PoP.
expression BQAA_LookbackDays = 90 meta [IsParameterQuery=true, Type="Number", IsParameterQueryRequired=true]
	lineageTag: 4749e7de-3efc-5005-bdaf-e6837d1fa341

/// Whether GoogleBigQuery.Database uses the BigQuery Storage Read API.
expression BQAA_UseStorageApi = true meta [IsParameterQuery=true, Type="Logical", IsParameterQueryRequired=true]
	lineageTag: f0173bdf-54c0-5fcf-9631-8f78051a5bcc

/// Shared configuration, parameter validation, partition anchor, and SQL builder.
expression BQAA_Config =
		let
			Lower = Text.ToList("abcdefghijklmnopqrstuvwxyz"),
			Upper = Text.ToList("ABCDEFGHIJKLMNOPQRSTUVWXYZ"),
			Digits = Text.ToList("0123456789"),
			Reject = (name as text) => error Error.Record("BQAA.InvalidParameter", name & " failed validation (see dashboards/power_bi/README.md#parameters)"),
			Only = (s as text, allowed as list) as logical => Text.Select(s, allowed) = s,
			IsProject = (s as any) as logical => s is text and Text.Length(s) >= 6 and Text.Length(s) <= 30 and Only(s, Lower & Digits & {"-"}) and List.Contains(Lower, Text.Start(s, 1)) and Text.End(s, 1) <> "-",
			IsDataset = (s as any) as logical => s is text and Text.Length(s) >= 1 and Text.Length(s) <= 1024 and Only(s, Lower & Upper & Digits & {"_"}) and not List.Contains(Digits, Text.Start(s, 1)),
			IsTable = (s as any) as logical => s is text and Text.Length(s) >= 1 and Text.Length(s) <= 1024 and Only(s, Lower & Upper & Digits & {"_", "-"}) and Text.Start(s, 1) <> "-",
			IsLookback = (n as any) as logical => n is number and Number.RoundDown(n) = n and n >= 1 and n <= 366,
			IsLogical = (b as any) as logical => b is logical,
			ParseIsoDate = (raw as text) as nullable date => let s = Text.Trim(raw), ok = Text.Length(s) = 10 and Text.At(s, 4) = "-" and Text.At(s, 7) = "-" and Only(Text.Range(s, 0, 4) & Text.Range(s, 5, 2) & Text.Range(s, 8, 2), Digits), d = if ok then try #date(Number.FromText(Text.Range(s, 0, 4)), Number.FromText(Text.Range(s, 5, 2)), Number.FromText(Text.Range(s, 8, 2))) otherwise null else null in d,
			IsWindowEnd = (s as any) as logical => s is text and (Text.Lower(Text.Trim(s)) = "auto" or ParseIsoDate(s) <> null),
			Project = if IsProject(BQAA_ProjectId) then BQAA_ProjectId else Reject("BQAA_ProjectId"),
			Billing = if IsProject(BQAA_BillingProjectId) then BQAA_BillingProjectId else Reject("BQAA_BillingProjectId"),
			Dataset = if IsDataset(BQAA_DatasetId) then BQAA_DatasetId else Reject("BQAA_DatasetId"),
			Table = if IsTable(BQAA_TableId) then BQAA_TableId else Reject("BQAA_TableId"),
			Lookback = if IsLookback(BQAA_LookbackDays) then BQAA_LookbackDays else Reject("BQAA_LookbackDays"),
			UseStorageApi = if IsLogical(BQAA_UseStorageApi) then (BQAA_UseStorageApi = true) else Reject("BQAA_UseStorageApi"),
			WindowEndRaw = if IsWindowEnd(BQAA_WindowEndDate) then Text.Trim(BQAA_WindowEndDate) else Reject("BQAA_WindowEndDate"),
			Nav = GoogleBigQuery.Database([BillingProject = Billing, UseStorageApi = UseStorageApi]){[Name = Billing]}[Data],
			TableRef = "`" & Project & "." & Dataset & "." & Table & "`",
			UtcToday = Date.From(DateTimeZone.SwitchZone(DateTimeZone.UtcNow(), 0)),
			AnchorSql = "SELECT MAX(IF(partition_id NOT IN ('__NULL__', '__UNPARTITIONED__') AND total_rows > 0, partition_id, NULL)) AS newest_partition, COUNTIF(partition_id = '__UNPARTITIONED__' AND total_rows > 0) AS buffered_partitions FROM `" & Project & "." & Dataset & ".INFORMATION_SCHEMA.PARTITIONS` WHERE table_name = '" & Table & "'",
			ParsePartitionDate = (pid as nullable text) as nullable date => if pid <> null and Text.Length(pid) >= 8 and Only(Text.Start(pid, 8), Digits) then try #date(Number.FromText(Text.Range(pid, 0, 4)), Number.FromText(Text.Range(pid, 4, 2)), Number.FromText(Text.Range(pid, 6, 2))) otherwise null else null,
			FallbackAnchor = let fb = try Table.First(Value.NativeQuery(Nav, "SELECT DATE(MAX(timestamp), 'UTC') AS newest_date FROM " & TableRef)) otherwise null, raw = if fb <> null then Record.FieldOrDefault(fb, "newest_date", null) else null, d = if raw is date then raw else if raw is datetime then Date.From(raw) else null in if d <> null then d else UtcToday,
			AutoAnchor = let metaRow = try Table.First(Value.NativeQuery(Nav, AnchorSql)) otherwise null, partDate = if metaRow <> null then ParsePartitionDate(Record.FieldOrDefault(metaRow, "newest_partition", null)) else null, buffered = if metaRow <> null then Record.FieldOrDefault(metaRow, "buffered_partitions", 0) else 0, resolved = if partDate <> null then (if buffered <> null and buffered > 0 and UtcToday > partDate then UtcToday else partDate) else FallbackAnchor in resolved,
			Anchor = if Text.Lower(WindowEndRaw) = "auto" then AutoAnchor else ParseIsoDate(WindowEndRaw),
			CurrentStart = Date.AddDays(Anchor, -(Lookback - 1)),
			LoadStart = Date.AddDays(CurrentStart, -Lookback),
			DateLit = (d as date) as text => "DATE '" & Date.ToText(d, [Format = "yyyy-MM-dd", Culture = "en-US"]) & "'",
			EventsSelectLines = {
				"SELECT",
				"  timestamp,",
				"  event_type,",
				"  agent,",
				"  session_id,",
				"  invocation_id,",
				"  user_id,",
				"  trace_id,",
				"  span_id,",
				"  parent_span_id,",
				"  status,",
				"  error_message,",
				"  is_truncated,",
				"  IF(",
				"    event_type = 'LLM_RESPONSE',",
				"    COALESCE(",
				"      SAFE_CAST(",
				"        JSON_VALUE(",
				"          attributes, '$.usage_metadata.prompt_token_count'",
				"        ) AS INT64",
				"      ),",
				"      SAFE_CAST(",
				"        JSON_VALUE(",
				"          attributes, '$.usage_metadata.prompt_tokens'",
				"        ) AS INT64",
				"      ),",
				"      SAFE_CAST(JSON_VALUE(content, '$.usage.prompt') AS INT64)",
				"    ),",
				"    NULL",
				"  ) AS usage_prompt_tokens,",
				"  IF(",
				"    event_type = 'LLM_RESPONSE',",
				"    COALESCE(",
				"      SAFE_CAST(",
				"        JSON_VALUE(",
				"          attributes, '$.usage_metadata.candidates_token_count'",
				"        ) AS INT64",
				"      ),",
				"      SAFE_CAST(",
				"        JSON_VALUE(",
				"          attributes, '$.usage_metadata.completion_tokens'",
				"        ) AS INT64",
				"      ),",
				"      SAFE_CAST(JSON_VALUE(content, '$.usage.completion') AS INT64)",
				"    ),",
				"    NULL",
				"  ) AS usage_completion_tokens,",
				"  IF(",
				"    event_type = 'LLM_RESPONSE',",
				"    COALESCE(",
				"      SAFE_CAST(",
				"        JSON_VALUE(",
				"          attributes, '$.usage_metadata.total_token_count'",
				"        ) AS INT64",
				"      ),",
				"      SAFE_CAST(",
				"        JSON_VALUE(",
				"          attributes, '$.usage_metadata.total_tokens'",
				"        ) AS INT64",
				"      ),",
				"      SAFE_CAST(JSON_VALUE(content, '$.usage.total') AS INT64)",
				"    ),",
				"    NULL",
				"  ) AS usage_total_tokens,",
				"  IF(",
				"    event_type = 'LLM_RESPONSE',",
				"    SAFE_CAST(JSON_VALUE(latency_ms, '$.total_ms') AS INT64),",
				"    NULL",
				"  ) AS llm_total_ms,",
				"  IF(",
				"    event_type = 'LLM_RESPONSE',",
				"    SAFE_CAST(",
				"      JSON_VALUE(latency_ms, '$.time_to_first_token_ms') AS INT64",
				"    ),",
				"    NULL",
				"  ) AS ttft_ms,",
				"  IF(",
				"    event_type = 'LLM_RESPONSE',",
				"    JSON_VALUE(attributes, '$.model_version'),",
				"    NULL",
				"  ) AS model_version,",
				"  IF(",
				"    event_type = 'TOOL_COMPLETED',",
				"    JSON_VALUE(content, '$.tool'),",
				"    NULL",
				"  ) AS tool_completed_name,",
				"  IF(",
				"    event_type = 'TOOL_COMPLETED',",
				"    JSON_VALUE(content, '$.tool_origin'),",
				"    NULL",
				"  ) AS tool_completed_origin,",
				"  IF(",
				"    event_type = 'TOOL_COMPLETED',",
				"    SAFE_CAST(JSON_VALUE(latency_ms, '$.total_ms') AS INT64),",
				"    NULL",
				"  ) AS tool_completed_total_ms,",
				"  IF(",
				"    event_type = 'TOOL_ERROR',",
				"    JSON_VALUE(content, '$.tool'),",
				"    NULL",
				"  ) AS tool_error_name,",
				"  IF(",
				"    event_type = 'TOOL_ERROR',",
				"    JSON_VALUE(content, '$.tool_origin'),",
				"    NULL",
				"  ) AS tool_error_origin,",
				"  IF(",
				"    event_type = 'TOOL_ERROR',",
				"    SAFE_CAST(JSON_VALUE(latency_ms, '$.total_ms') AS INT64),",
				"    NULL",
				"  ) AS tool_error_total_ms,",
				"  DATE(timestamp, 'UTC') AS event_date,",
				"  CONCAT(trace_id, '|', span_id) AS event_pk,",
				"  IF(",
				"    event_type = 'LLM_RESPONSE',",
				"    CONCAT(trace_id, '|', span_id),",
				"    NULL",
				"  ) AS llm_response_pk,",
				"  IF(",
				"    event_type = 'TOOL_COMPLETED',",
				"    CONCAT(trace_id, '|', span_id),",
				"    NULL",
				"  ) AS tool_completed_pk,",
				"  IF(",
				"    event_type = 'TOOL_ERROR',",
				"    CONCAT(trace_id, '|', span_id),",
				"    NULL",
				"  ) AS tool_error_pk"
			},
			EventsSql = Text.Combine(EventsSelectLines & {"FROM " & TableRef, "WHERE timestamp >= TIMESTAMP(" & DateLit(LoadStart) & ", 'UTC')", "  AND timestamp < TIMESTAMP(DATE_ADD(" & DateLit(Anchor) & ", INTERVAL 1 DAY), 'UTC')"}, "#(lf)")
		in
			[Nav = Nav, TableRef = TableRef, Anchor = Anchor, CurrentStart = CurrentStart, LoadStart = LoadStart, Lookback = Lookback, EventsSql = EventsSql]
	lineageTag: 0b50ace4-571a-52c3-805c-3188f43d15b0
