{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/report/3.3.0/schema.json",
  "themeCollection": {
    "customTheme": {
      "name": "BQAA.json",
      "reportVersionAtImport": {
        "visual": "2.13.0",
        "page": "2.1.0",
        "report": "3.3.0"
      },
      "type": "RegisteredResources"
    }
  },
  "resourcePackages": [
    {
      "name": "RegisteredResources",
      "type": "RegisteredResources",
      "items": [
        {
          "name": "BQAA.json",
          "path": "BQAA.json",
          "type": "CustomTheme"
        }
      ]
    }
  ],
  "filterConfig": {
    "filters": [
      {
        "name": "bqaa-report-window",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Date"
              }
            },
            "Property": "Window"
          }
        },
        "type": "Categorical",
        "howCreated": "User",
        "isHiddenInViewMode": true,
        "isLockedInViewMode": true,
        "filter": {
          "Version": 2,
          "From": [
            {
              "Name": "a",
              "Entity": "Date",
              "Type": 0
            }
          ],
          "Where": [
            {
              "Condition": {
                "In": {
                  "Expressions": [
                    {
                      "Column": {
                        "Expression": {
                          "SourceRef": {
                            "Source": "a"
                          }
                        },
                        "Property": "Window"
                      }
                    }
                  ],
                  "Values": [
                    [
                      {
                        "Literal": {
                          "Value": "'Current'"
                        }
                      }
                    ]
                  ]
                }
              }
            }
          ]
        }
      },
      {
        "name": "bqaa-session-id",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "events_v1"
              }
            },
            "Property": "session_id"
          }
        },
        "type": "Categorical",
        "howCreated": "User"
      },
      {
        "name": "bqaa-model-version",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "events_v1"
              }
            },
            "Property": "model_version"
          }
        },
        "type": "Categorical",
        "howCreated": "User"
      }
    ]
  }
}
